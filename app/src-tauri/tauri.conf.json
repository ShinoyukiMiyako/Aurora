{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petalfall",
  "mainBinaryName": "Petalfall",
  "version": "0.1.0",
  "identifier": "org.petalfall.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petalfall",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 720,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#FBF7F9",
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "193d3334-0a08-54d3-aeaa-cd60d51b2f6a"
      }
    }
  }
}
