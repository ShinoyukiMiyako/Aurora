{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petalfall",
  "mainBinaryName": "Petalfall",
  "version": "0.1.0",
  "identifier": "org.petalfall.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petalfall",
        "width": 1120,
        "height": 720,
        "minWidth": 960,
        "minHeight": 720,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#FBF7F9",
        "zoomHotkeysEnabled": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost petalfall-tex: http://petalfall-tex.localhost data:",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Shinoyuki_Miyako",
    "homepage": "https://petalfall.org",
    "copyright": "Copyright (C) 2026 Shinoyuki_Miyako",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../LICENSE-ADDITIONAL-TERMS.md": "LICENSE-ADDITIONAL-TERMS.md",
      "../../LICENSE-ASSETS.md": "LICENSE-ASSETS.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese"],
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "193d3334-0a08-54d3-aeaa-cd60d51b2f6a"
      }
    }
  }
}
